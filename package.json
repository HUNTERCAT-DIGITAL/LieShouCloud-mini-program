{
  "name": "@lieshoucloud/mini-program-app",
  "version": "0.0.1",
  "private": true,
  "description": "LieShou Cloud WeChat Mini Program (Taro 4 + React) minimal skeleton.",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "build": "taro build --type weapp",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint: Taro ESLint config deferred to Phase 2\" && exit 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lieshoucloud/api-client": "workspace:*",
    "@lieshoucloud/types": "workspace:*",
    "@tarojs/components": "4.0.0",
    "@tarojs/react": "4.0.0",
    "@tarojs/runtime": "4.0.0",
    "@tarojs/shared": "4.0.0",
    "@tarojs/taro": "4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-react": "^8.0.1",
    "@lieshoucloud/config": "workspace:*",
    "@tarojs/cli": "4.0.0",
    "@tarojs/helper": "4.0.0",
    "@tarojs/plugin-framework-react": "4.0.0",
    "@tarojs/plugin-platform-h5": "4.0.0",
    "@tarojs/plugin-platform-weapp": "4.0.0",
    "@tarojs/webpack5-runner": "4.0.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "~22.9.0",
    "@types/react": "^18.3.12",
    "@types/webpack-env": "^1.18.5",
    "babel-preset-taro": "4.0.0",
    "jsdom": "30.0.1",
    "typescript": "5.6.3",
    "vitest": "3.0.5",
    "webpack": "5.91.0"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.0.0 <10.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}