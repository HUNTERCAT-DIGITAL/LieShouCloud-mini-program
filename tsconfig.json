{
  "extends": "@lieshoucloud/config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["@tarojs/taro", "react", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@lieshoucloud/api-client": ["./open/packages/api-client/src"],
      "@lieshoucloud/types": ["./open/packages/types/src"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["src", "config", "types"]
}
